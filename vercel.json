{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "rapport.html", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "headers": { "Content-Type": "application/javascript" },
      "dest": "/sw.js"
    },
    {
      "src": "/rapport.html",
      "dest": "/rapport.html"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
